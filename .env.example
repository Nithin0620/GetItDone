# Google OAuth credentials (Google Cloud Console -> OAuth client for a Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=getitdone

# Optional: public URL used by Google OAuth callbacks in production
AUTH_URL=http://localhost:3000
